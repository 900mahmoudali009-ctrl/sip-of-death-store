[TEMPLATE]
# SIP OF DEATH — API server configuration (PostgreSQL / Supabase edition)

# ---- REQUIRED: Postgres connection (Supabase → Project Settings → Database) ----
# Use the "Connection pooling" URI (port 6543) for Render free tier.
DATABASE_URL=postgres://postgres.XXXX:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
# SSL is auto-enabled for supabase hosts; force with PGSSL=require if needed.
# PGSSL=require

# ---- Server ----
# Render injects PORT automatically; locally defaults to 5050.
# PORT=5050
# Public origin (used for gateway success/cancel redirects)
STORE_URL=http://localhost:5050
NODE_ENV=development

# ---- Admin console (created on first boot; CHANGE THE PASSWORD from /admin) ----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe123!

# ---- Product image uploads (Supabase Storage) ----
# Supabase → Project Settings → API (Project URL + service_role key)
# Storage → create a PUBLIC bucket named product-images
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=product-images

# ---- Paymob (primary card gateway) ---------------------------------
PAYMOB_API_KEY=
PAYMOB_INTEGRATION_ID=
PAYMOB_IFRAME_ID=
PAYMOB_HMAC_SECRET=

# ---- Stripe (alternative) ------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- Sandbox -------------------------------------------------------
# 'off' forbids the mock provider (also off when NODE_ENV=production)
# MOCK_GATEWAY=off
MOCK_HMAC_SECRET=sod-mock-hmac-secret
